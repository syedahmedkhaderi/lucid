{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lucid",
  "version": "0.1.0",
  "identifier": "com.lucid.desktop",
  "build": {
    "beforeDevCommand": "node scripts/fetch-onnxruntime.mjs && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node scripts/fetch-onnxruntime.mjs && npm run build",
    "beforeBundleCommand": "node scripts/nsis-release-info.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "launcher",
        "title": "Lucid",
        "width": 900,
        "height": 650,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Lucid Overlay",
        "width": 500,
        "height": 700,
        "minWidth": 400,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "x": 50,
        "y": 50
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "Lucid — AI Meeting Assistant"
    },
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/recordings/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "./nsis-hooks.nsh",
        "template": "./nsis/installer.nsi"
      }
    }
  },
  "plugins": {}
}
